# Offline scorecard. NVIDIA and RAGFlow settings are optional.
# Copy this file to .env and fill in values there. Do not commit .env.

# mock uses the offline judge and hashed token vectors.
# nvidia calls the NVIDIA API. auto uses nvidia when NVIDIA_API_KEY is set.
LLM_PROVIDER=mock

# Placeholder only. Never commit a real key.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_EMBED_MODEL=nvidia/nv-embedqa-e5-v5

# Leave the RAGFlow values empty to stay on the local fixture index.
SCORECARD_MODE=local
RAGFLOW_BASE_URL=http://localhost:9380
RAGFLOW_API_KEY=
RAGFLOW_DATASET_ID=
# Sent only for configs with rerank=true.
RAGFLOW_RERANK_ID=
